{
  "name": "iwork-client",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@12.18.0",
  "scripts": {
    "gen": "buf generate",
    "typecheck": "pnpm gen && tsc --noEmit -p tsconfig.json && tsc --noEmit -p tsconfig.node.json && tsc --noEmit -p tsconfig.test.json",
    "test": "pnpm gen && pnpm fixtures && vitest run",
    "dev": "vite",
    "build": "vite build",
    "tauri": "node scripts/tauri.ts",
    "fixtures": "cargo run -q -p iwork-client-core --example dump-view-fixtures -- fixtures",
    "preview:ui": "pnpm gen && pnpm fixtures && vite --open /preview.html"
  },
  "dependencies": {
    "@bufbuild/protobuf": "2.16.0",
    "@fontsource-variable/inter": "5.3.0",
    "@fontsource-variable/jetbrains-mono": "5.3.0",
    "@fontsource-variable/noto-sans-sc": "5.3.1",
    "@tauri-apps/api": "2.12.4",
    "mdast-util-from-markdown": "2.1.0",
    "mdast-util-gfm": "3.1.0",
    "micromark-extension-gfm": "3.0.0",
    "solid-js": "1.9.17"
  },
  "devDependencies": {
    "@bufbuild/buf": "1.75.0",
    "@bufbuild/protoc-gen-es": "2.16.0",
    "@solidjs/testing-library": "0.8.10",
    "@tauri-apps/cli": "2.12.4",
    "@testing-library/dom": "10.4.2",
    "@testing-library/jest-dom": "7.0.1",
    "@types/mdast": "4.0.4",
    "@types/node": "26.6.5",
    "jsdom": "30.1.3",
    "typescript": "6.0.3",
    "vite": "8.3.5",
    "vite-plugin-solid": "2.11.14",
    "vitest": "5.0.5"
  }
}
